<!DOCTYPE aseba-playground>
<aseba-playground>
	<author name="Marc-Philipp Paarmann" />
	<author name="Christian Charles" />
	<author name="Mariza Freire" email="mariza dot freire at mobsya dot org" />
	<author name="Stéphane Magnenat" email="stephane at magnenat dot net" />
	
	<thanks name="Gebert Rüf Stiftung" />

	<description lang="en">A ground board for Thymio discovery kit, <i>Otter</i> theme.</description>
	<description lang="fr">Un plateau de sol pour le kit de découverte Thymio, thème <i>Otarie</i>.</description>

	<externalLink lang="en" type="wiki" target="en:thymiodiscoverykitotter" />
	<externalLink lang="fr" type="wiki" target="fr:thymiodiscoverykitotter" />

	<color name="white" r="1.0" g="1.0" b="1.0" />
	
	<world w="104.1" h="79.4" color="white" groundTexture="Acht_grau" />
	
	<robot type="thymio2" x="70" y="15" port="33333" name="Thymio" />

<robot type="thymio2" x="80" y="70" port="33334" name="ThymioZwei" />
	
	<process command=":asebamassloader --once thymio-default-behaviours.aesl tcp:localhost;33333" />
</aseba-playground>
